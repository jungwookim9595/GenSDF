<?xml version="1.0" ?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0">
  <Domain>
    <!-- Topology describes the mesh (grid structure). -->
    <!-- Dimensions order is K J I (slowest→fastest), matching Fortran column-major layout.     -->
    <!-- sdfp.bin is written as padded(nx+2, nz+2, ny) so I=nx+2=514, J=nz+2=130, K=ny=128.  -->
    <Topology TopologyType="3DRectMesh" Dimensions="128 130 514" />

    <!-- Geometry defines the physical coordinates of the points in the mesh.                  -->
    <!-- XDMF X (I, fastest) = GenSDF x-streamwise  → xgrid_pad.bin  (514 pts, with ghost)   -->
    <!-- XDMF Y (J, middle)  = GenSDF z-wall-normal → wngrid_pad.bin (130 pts, with ghost)   -->
    <!-- XDMF Z (K, slowest) = GenSDF y-spanwise    → spgrid.bin     (128 pts, no ghost)     -->
    <!-- Generate these files with write_xmf_grid.py                                          -->
    <Geometry GeometryType="VXVYVZ">
      <!-- X-coordinates (streamwise, ghost-padded) -->
      <DataItem Format="Binary" DataType="Float" Precision="8" Endian="Big" Dimensions="514">
        xgrid_pad.bin
      </DataItem>
      <!-- Y-coordinates (wall-normal, ghost-padded) -->
      <DataItem Format="Binary" DataType="Float" Precision="8" Endian="Big" Dimensions="130">
        wngrid_pad.bin
      </DataItem>
      <!-- Z-coordinates (spanwise, no ghost) -->
      <DataItem Format="Binary" DataType="Float" Precision="8" Endian="Big" Dimensions="128">
        spgrid.bin
      </DataItem>
    </Geometry>

    <!-- Grid refers to time-varying data (optional). -->
    <Grid Name="TimeSeries" GridType="Collection" CollectionType="Temporal">
      <!-- Time description -->
      <Time TimeType="List">
        <DataItem Format="XML" Dimensions="1">
          0.0
        </DataItem>
      </Time>

      <!-- Uniform Grid for each time step (in this case, just one step). -->
      <Grid Name="Timestep_0" GridType="Uniform">
        <Topology Reference="/Xdmf/Domain/Topology" />
        <Geometry Reference="/Xdmf/Domain/Geometry" />

        <!-- Scalar field stored at each grid point (your binary data) -->
        <Attribute Name="SDF" AttributeType="Scalar" Center="Node">
          <DataItem Format="Binary" DataType="Float" Precision="8" Endian="Big" Dimensions="128 130 514" Seek="0">
            sdfp.bin
          </DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
