# Name and location of the input geometry (OBJ or binary STL, detected by extension)
'data/armadillo_withnormals.obj'
# Scalar default value (real), narrow-band buffer_points (int), progress bar width (int)
100  8  40
# Grid dimensions nx, ny, nz (interior cell-centres, matching geometry.out)
512 128 128
# Grid origin r0(1) r0(2) r0(3)
0.0 0.0 0.0
# Non-uniform z grid (.true. reads data/grid.out, .false. uses uniform spacing)
.false.
# Use fast-sweep algorithm (.true. = narrow-band + FSM; .false. = original brute-force)
.true.
# Narrow-band width in cells (must be >= n_image_layers + 2 = 4 for dopamine IBM)
8
# Vertical (wall-normal) axis of the solver (2 = y-vertical, 3 = z-vertical)
3
# Compute face-staggered SDFs (sdfu, sdfv, sdfw) in addition to cell-centre sdfp
# (.false. = cell-centre only; .true. = all four SDFs)
.false.
